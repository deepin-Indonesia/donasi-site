---
const cards = [
  {
    icon: 'fa-box-open',
    title: 'Out of the Box',
    desc: 'deepin hadir dengan beragam aplikasi bawaan yang siap pakai. Cukup instal dan langsung produktif — tanpa perlu setup tambahan.',
  },
  {
    icon: 'fa-face-smile',
    title: 'User-Friendly',
    desc: 'Antarmuka yang intuitif dan modern membuat deepin cocok untuk pemula maupun pengguna berpengalaman dari sistem operasi lain.',
  },
  {
    icon: 'fa-shield-halved',
    title: 'Privasi Terjaga',
    desc: 'deepin menghormati data Anda. Tidak ada telemetri agresif atau pengumpulan data tanpa izin. Privasi Anda adalah prioritas.',
  },
  {
    icon: 'fa-puzzle-piece',
    title: 'Ekosistem Lengkap',
    desc: 'Dari UOS AI hingga Cross-Device Collaboration, deepin menawarkan ekosistem aplikasi yang saling terintegrasi.',
  },
  {
    icon: 'fa-code',
    title: 'Open Source',
    desc: 'Dibangun di atas fondasi Linux dan terbuka untuk kontribusi. Kode sumber tersedia untuk dipelajari dan dikembangkan.',
  },
  {
    icon: 'fa-users',
    title: 'Komunitas Kuat',
    desc: 'Didukung oleh kontributor global dan komunitas Indonesia yang solid. Bergabunglah dan jadilah bagian dari perubahan.',
    link: 'https://t.me/Linux_deepin_ID',
    linkText: 'Gabung Telegram',
  },
];
---

<section class="py-20 bg-white">
  <div class="container-main">
    <div class="text-center mb-14">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-deepin-50 text-deepin-700 text-xs font-semibold tracking-wide uppercase mb-4">
        <i class="fas fa-star text-[10px]"></i> Kenapa deepin?
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900">
        Dibuat untuk <span class="text-deepin-600">Pengalaman Terbaik</span>
      </h2>
      <p class="mt-3 text-gray-500 max-w-2xl mx-auto">
        deepin bukan sekadar distribusi Linux. Ia adalah hasil riset mendalam tentang bagaimana manusia berinteraksi dengan teknologi.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map((card) => (
        <div class="card p-6 group hover:-translate-y-1 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-deepin-50 flex items-center justify-center mb-4 group-hover:bg-deepin-100 transition-colors">
            <i class={`fas ${card.icon} text-xl text-deepin-600`}></i>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">{card.title}</h3>
          <p class="text-sm text-gray-500 leading-relaxed">{card.desc}</p>
          {card.link && (
            <a href={card.link} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 mt-3 text-sm font-medium text-deepin-600 hover:text-deepin-700 transition-colors">
              {card.linkText} <i class="fas fa-arrow-right text-xs" />
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
