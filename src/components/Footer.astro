---
import { SITE } from '@/data/site';
---

<footer class="bg-gray-900 text-gray-300 pt-16 pb-8">
  <div class="container-main">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <!-- Brand -->
      <div>
        <img src="/images/deepin-id-text_nobg.png" alt="deepin Indonesia" width="140" height="28" class="h-7 w-auto mb-4 brightness-0 invert opacity-80" loading="lazy" decoding="async" />
        <p class="text-sm text-gray-400 leading-relaxed">
          Komunitas resmi pengguna deepin Linux di Indonesia. Dikelola oleh relawan.
        </p>
        <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-1.5 mt-3 text-sm text-gray-400 hover:text-white transition-colors">
          <i class="fas fa-envelope text-xs" /> {SITE.email}
        </a>
      </div>

      <!-- Halaman -->
      <div>
        <h4 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">Halaman</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="https://deepin.id" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="https://os.deepin.id" class="hover:text-white transition-colors">Download</a></li>
          <li><a href="https://news.deepin.id" class="hover:text-white transition-colors">News</a></li>
          <li><a href="https://donasi.deepin.id" class="hover:text-deepin-400 transition-colors font-medium">❤️ Donasi</a></li>
        </ul>
      </div>

      <!-- Tentang -->
      <div>
        <h4 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">Tentang deepin</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#" class="hover:text-white transition-colors">Product Planning</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Original Apps</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Desktop Environment</a></li>
          <li><a href="#" class="hover:text-white transition-colors font-medium text-deepin-400">deepin Indonesia</a></li>
        </ul>
      </div>

      <!-- Ikuti Kami -->
      <div>
        <h4 class="text-white font-semibold text-sm mb-4 uppercase tracking-wider">Ikuti Kami</h4>
        <div class="flex gap-3 mb-4">
          <a href={SITE.social.telegram} target="_blank" rel="noopener" class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center hover:bg-[#0088cc] transition-colors" title="Telegram">
            <i class="fab fa-telegram-plane" />
          </a>
          <a href={SITE.social.github} target="_blank" rel="noopener" class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors" title="GitHub">
            <i class="fab fa-github" />
          </a>
          <a href={SITE.social.youtube} target="_blank" rel="noopener" class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center hover:bg-[#ff0000] transition-colors" title="YouTube">
            <i class="fab fa-youtube" />
          </a>
        </div>
        <a href="https://distrowatch.com/table.php?distribution=deepin" target="_blank" rel="noopener"
           class="inline-flex items-center gap-1.5 text-xs text-gray-500 hover:text-gray-300 transition-colors mt-2">
          <i class="fas fa-external-link-alt" /> DistroWatch
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-500">
      <p>&copy; {new Date().getFullYear()} deepin Indonesia. Bagian dari <strong class="text-gray-400">SIBERIN</strong></p>
      <p class="opacity-60">
        Situs ini menggunakan Google Analytics. <a href="https://policies.google.com/privacy" target="_blank" rel="noopener" class="underline hover:text-gray-400">Kebijakan Privasi Google</a>
      </p>
    </div>
  </div>
</footer>
