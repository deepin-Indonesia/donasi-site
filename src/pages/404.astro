---
import Layout from '@/components/Layout.astro';
---

<Layout title="Halaman Tidak Ditemukan">
  <section class="min-h-[85vh] flex items-center justify-center bg-gradient-to-b from-gray-50 via-white to-deepin-50/30 py-16">
    <div class="text-center container-main max-w-xl">
      <!-- Decorative 404 -->
      <div class="relative inline-block mb-6">
        <div class="text-[140px] sm:text-[180px] font-black leading-none bg-gradient-to-br from-deepin-400 via-deepin-500 to-deepin-700 bg-clip-text text-transparent select-none">
          404
        </div>
        <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-24 h-1 bg-gradient-to-r from-transparent via-deepin-400 to-transparent rounded-full" />
      </div>

      <!-- Message -->
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3">
        Halaman Tidak Ditemukan
      </h1>
      <p class="text-gray-500 leading-relaxed max-w-sm mx-auto mb-3 text-[15px]">
        Sepertinya halaman yang kamu tuju sudah dipindahkan ke alamat lain, sudah dihapus, salah ketik alamat, atau memang halaman tersebut tidak pernah ada sejak awal.
      </p>
      <p class="text-xs text-gray-400 font-mono bg-gray-100 rounded-lg px-3 py-2 inline-block mb-8 break-all max-w-full">
        {Astro.url.pathname}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-10">
        <a href="https://deepin.id" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-deepin-600 text-white font-semibold text-sm hover:bg-deepin-700 hover:-translate-y-0.5 transition-all shadow-lg shadow-deepin-600/20 w-full sm:w-auto justify-center">
          <i class="fas fa-home text-xs" />
          Kembali ke Beranda
        </a>
        <a href="https://t.me/Linux_deepin_ID" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border-2 border-gray-200 text-gray-700 font-semibold text-sm hover:border-[#0088cc] hover:text-[#0088cc] hover:-translate-y-0.5 transition-all w-full sm:w-auto justify-center">
          <i class="fab fa-telegram-plane text-xs" />
          Gabung Komunitas
        </a>
      </div>

      <!-- Help Card -->
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 sm:p-6 mx-auto max-w-md">
        <p class="text-sm font-semibold text-gray-700 mb-3 flex items-center justify-center gap-2">
          <i class="fas fa-headset text-deepin-500" />
          Butuh Bantuan?
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-sm">
          <a href="mailto:deepin@siberin.id" class="inline-flex items-center gap-1.5 text-deepin-600 hover:text-deepin-800 font-medium transition-colors">
            <i class="fas fa-envelope text-xs" /> deepin@siberin.id
          </a>
          <span class="hidden sm:inline text-gray-300">|</span>
          <a href="https://t.me/Linux_deepin_ID" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-deepin-600 hover:text-deepin-800 font-medium transition-colors">
            <i class="fab fa-telegram-plane text-xs" /> Tanya Komunitas
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
