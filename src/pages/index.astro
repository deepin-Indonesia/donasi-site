---
import Layout from '@/components/Layout.astro';
import { SITE } from '@/data/site';

const tipsText = `Jangan ragu untuk bertanya atau berdiskusi di grup Telegram kami. Komunitas deepin Indonesia selalu siap membantu!

📢 **Cara bergabung:**
1. Klik tautan: https://t.me/Linux_deepin_ID
2. Perkenalkan diri kamu
3. Mulai berdiskusi dan berbagi pengalaman`;
---

<Layout title="Donasi" description="Dukung pengembangan komunitas deepin Indonesia.">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-gray-900 via-slate-800 to-deepin-900 py-16 lg:py-20">
    <div class="container-main relative text-center">
      <img src="/images/deepin-id.png" alt="deepin" width="96" height="96" class="w-24 h-24 mx-auto mb-5 drop-shadow-xl" />
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white">
        Donasi <span class="text-deepin-400">deepin</span> Indonesia
      </h1>
      <p class="mt-3 text-deepin-200 text-lg">Dukung kami untuk terus berkembang</p>
    </div>
  </section>

  <!-- Payment Section -->
  <section class="py-12 bg-gray-50">
    <div class="container-main">
      <div class="grid lg:grid-cols-5 gap-8">
        <!-- Info -->
        <div class="lg:col-span-3 space-y-5">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-deepin-50 text-deepin-700 text-xs font-semibold">
            <i class="fas fa-heart text-[10px]" /> DONASI
          </span>
          <h2 class="text-3xl font-extrabold text-gray-900">Bantu Kami Berkembang</h2>
          <p class="text-gray-500 leading-relaxed">
            Komunitas deepin Indonesia dijalankan sepenuhnya oleh <strong class="text-gray-700">relawan</strong>.
            Donasi Anda digunakan untuk operasional server, event komunitas, pembuatan konten edukasi,
            dan pengembangan ekosistem deepin di Indonesia.
          </p>

          <!-- Notes -->
          <div class="bg-deepin-50 border border-deepin-200 rounded-xl p-4 text-sm text-deepin-800 space-y-2">
            <p><i class="fas fa-info-circle mr-2" /><strong>Nama</strong> dan <strong>email</strong> bersifat opsional — jika diisi akan ditampilkan di halaman ini. Email otomatis disensor.</p>
            <p><i class="fas fa-shield-alt mr-2" /><strong>Nomor HP</strong> tidak akan pernah ditampilkan secara publik.</p>
            <p><i class="fas fa-user-secret mr-2" />Jika nama dikosongkan, donasi dicatat sebagai <strong>anonim</strong>.</p>
          </div>

          <!-- Other donation -->
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
            <p><i class="fas fa-hand-holding-heart mr-2" /><strong>Bentuk Donasi Lainnya:</strong> selain donasi tunai, kami juga terbuka untuk <strong>server</strong>, <strong>merchandise</strong>, <strong>sponsorship event</strong>, <strong>domain</strong>, dan lainnya — hubungi <a href={`mailto:${SITE.email}`} class="text-amber-900 underline font-semibold">{SITE.email}</a></p>
          </div>
        </div>

        <!-- Payment Card -->
        <div class="lg:col-span-2">
          <div class="card overflow-hidden sticky top-[90px]">
            <div class="bg-gradient-to-br from-deepin-600 to-deepin-800 p-6 text-center text-white">
              <div class="text-3xl mb-2">💝</div>
              <p class="text-sm opacity-80">Pilih nominal sesuka hati — tidak ada minimal</p>
            </div>
            <div class="p-6 text-center space-y-4">
              <a href="https://app.midtrans.com/payment-links/Donasi-deepin-Indonesia-qSHW6Bup"
                 target="_blank" rel="noopener"
                 class="flex items-center justify-center gap-2 w-full py-4 rounded-xl bg-red-500 hover:bg-red-600 text-white font-bold text-lg transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-red-500/25">
                <i class="fas fa-heart" /> Donasi via Midtrans <i class="fas fa-external-link-alt text-sm ml-1" />
              </a>
              <p class="text-xs text-gray-400"><i class="fas fa-lock mr-1 text-green-500" /> Pembayaran aman & terenkripsi</p>
              <div class="pt-4 border-t border-gray-100 flex flex-wrap justify-center gap-2">
                {['Bank Transfer', 'GoPay', 'Indomaret', 'QRIS'].map((m) => (
                  <span class="px-3 py-1.5 rounded-lg bg-gray-50 text-xs text-gray-500 font-medium">{m}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Donors placeholder -->
  <section class="py-16 bg-white">
    <div class="container-main text-center">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-3">Apresiasi Donatur</h2>
      <p class="text-gray-500">Data donatur akan ditampilkan di sini setelah ada donasi masuk.</p>
    </div>
  </section>
</Layout>
