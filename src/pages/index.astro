---
import Layout from '@/components/Layout.astro';
import { SITE } from '@/data/site';
import { donors, formatRupiah, lastUpdated, type Donor } from '@/data/donors';

const data = donors;

const allTotal = data.reduce((sum, d) => sum + d.amount, 0);
const allCount = data.length;

const anonDonors = data.filter(d => !d.name);
const anonTotal = anonDonors.reduce((sum, d) => sum + d.amount, 0);
const anonCount = anonDonors.length;

const publicDonors = data.filter(d => d.name && d.donor_id);
const grouped = new Map<string, { name: string; email: string; total: number; count: number }>();
for (const d of publicDonors) {
  const existing = grouped.get(d.donor_id);
  if (existing) { existing.total += d.amount; existing.count += 1; }
  else { grouped.set(d.donor_id, { name: d.name, email: d.email, total: d.amount, count: 1 }); }
}
const top3 = [...grouped.values()].sort((a, b) => b.total - a.total).slice(0, 3);

const latest = [...data].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 10);

function getDonorCount(donor: Donor) {
  if (!donor.name || !donor.donor_id) return 0;
  return publicDonors.filter(d => d.donor_id === donor.donor_id).length;
}
---

<Layout title="Donasi" description="Dukung pengembangan komunitas deepin Indonesia.">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-deepin-700 via-deepin-800 to-gray-900 py-16 lg:py-24">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(26,109,212,0.2)_0%,transparent_60%)]" />
    <div class="container-main relative text-center">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 text-deepin-200 text-xs font-semibold tracking-wide uppercase mb-6 backdrop-blur-sm">
        <i class="fas fa-heart text-red-400" /> Didukung Komunitas
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mb-4">
        Dukung <span class="text-deepin-400">deepin</span> Indonesia
      </h1>
      <p class="text-deepin-200 text-lg max-w-xl mx-auto">Setiap donasi membantu operasional server, event komunitas, dan konten edukasi deepin di Indonesia.</p>
      <!-- Quick Stats -->
      <div class="flex flex-wrap justify-center gap-6 mt-8">
        <div class="text-center">
          <div class="text-2xl font-extrabold text-white">Rp {formatRupiah(allTotal)}</div>
          <div class="text-xs text-deepin-300">Total Donasi</div>
        </div>
        <div class="text-center">
          <div class="text-2xl font-extrabold text-white">{allCount}</div>
          <div class="text-xs text-deepin-300">Donasi</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 bg-gray-50">
    <div class="container-main">
      <div class="grid lg:grid-cols-5 gap-10">
        <!-- Left: Info -->
        <div class="lg:col-span-3 space-y-6">
          <div>
            <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-deepin-50 text-deepin-700 text-xs font-semibold mb-4"><i class="fas fa-heart text-[10px]" /> DONASI</span>
            <h2 class="text-3xl font-extrabold text-gray-900 mb-3">Bantu Kami Berkembang</h2>
            <p class="text-gray-500 leading-relaxed">Komunitas deepin Indonesia berkomitmen menghadirkan ekosistem open source terbaik. Donasi Anda 100% digunakan untuk operasional server, event komunitas, pembuatan konten edukasi, dan pengembangan ekosistem deepin di Indonesia.</p>
          </div>
          
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="flex items-start gap-3 p-4 rounded-xl bg-white border border-gray-100">
              <i class="fas fa-check-circle text-green-500 mt-0.5" />
              <div><strong class="text-sm text-gray-800">Nama & email opsional</strong><p class="text-xs text-gray-500 mt-0.5">Email otomatis disensor. Kosongkan untuk anonim.</p></div>
            </div>
            <div class="flex items-start gap-3 p-4 rounded-xl bg-white border border-gray-100">
              <i class="fas fa-shield-alt text-green-500 mt-0.5" />
              <div><strong class="text-sm text-gray-800">Privasi terjamin</strong><p class="text-xs text-gray-500 mt-0.5">Nomor HP tidak akan pernah ditampilkan.</p></div>
            </div>
          </div>

          <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
            <p><i class="fas fa-hand-holding-heart mr-2" /><strong>Bentuk Donasi Lainnya:</strong> server, merchandise, sponsorship event, domain — hubungi <a href={`mailto:${SITE.email}`} class="text-amber-900 font-semibold hover:underline">{SITE.email}</a></p>
          </div>
        </div>

        <!-- Right: Midtrans Card -->
        <div class="lg:col-span-2">
          <div class="card overflow-hidden sticky top-[90px] shadow-xl border-2 border-deepin-100">
            <div class="bg-gradient-to-br from-deepin-600 to-deepin-800 p-6 text-center text-white">
              <div class="text-4xl mb-2">💝</div>
              <p class="font-bold text-lg">Donasi Sekarang</p>
              <p class="text-sm opacity-80 mt-1">Pilih nominal sesuka hati — tidak ada minimal</p>
            </div>
            <div class="p-6 text-center space-y-4">
              <a href="https://app.midtrans.com/payment-links/Donasi-deepin-Indonesia-qSHW6Bup" target="_blank" rel="noopener" class="flex items-center justify-center gap-2 w-full py-4 rounded-xl bg-red-500 hover:bg-red-600 text-white font-bold text-lg transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-red-500/25">
                <i class="fas fa-heart" /> Donasi via Midtrans <i class="fas fa-external-link-alt text-sm ml-1" />
              </a>
              <p class="text-xs text-gray-400"><i class="fas fa-lock mr-1 text-green-500" /> Pembayaran aman & terenkripsi</p>
              <div class="pt-4 border-t border-gray-100 grid grid-cols-2 gap-2">
                {['Bank Transfer','GoPay','QRIS','Virtual Account'].map((m) => (<span class="px-3 py-2 rounded-lg bg-gray-50 text-xs text-gray-500 font-medium text-center">{m}</span>))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Donors -->
  <section class="py-16 bg-white">
    <div class="container-main">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-2"><i class="fas fa-trophy text-amber-500 mr-2" /> Apresiasi Donatur</h2>
        <p class="text-gray-500">Total <strong>{allCount}</strong> donasi terkumpul senilai <strong>Rp {formatRupiah(allTotal)}</strong></p>
        <p class="text-xs text-gray-400 mt-1.5 italic"><i class="fas fa-sync-alt mr-1" /> Data per {lastUpdated}</p>
      </div>

      {anonCount > 0 && (
        <div class="max-w-md mx-auto mb-10 p-5 rounded-2xl border-2 border-dashed border-gray-200 bg-gray-50 text-center">
          <i class="fas fa-user-secret text-3xl text-gray-300 mb-2" />
          <h3 class="font-bold text-gray-700">Donatur Anonim</h3>
          <p class="text-sm text-gray-500 mt-1">{anonCount} donasi &middot; total <strong>Rp {formatRupiah(anonTotal)}</strong></p>
        </div>
      )}

      <!-- Top 3 -->
      <div class="grid sm:grid-cols-3 gap-6 max-w-2xl mx-auto mb-14">
        {top3.map((d, i) => (
          <div class="card p-5 pt-8 text-center relative group hover:-translate-y-1 transition-all duration-300">
            {i === 0 && <div class="text-2xl mb-1">👑</div>}
            {i === 1 && <div class="text-xl mb-1">🥈</div>}
            {i === 2 && <div class="text-xl mb-1">🥉</div>}
            <div class="w-14 h-14 rounded-full bg-deepin-50 flex items-center justify-center mx-auto mb-3 mt-2">
              <span class="text-lg font-extrabold text-deepin-600">{d.name.charAt(0)}</span>
            </div>
            <h3 class="font-bold text-gray-900 text-sm">{d.name}</h3>
            <p class="text-xs text-gray-400 font-mono mt-0.5">{d.email}</p>
            <p class="text-lg font-extrabold text-deepin-600 mt-2">Rp {formatRupiah(d.total)}</p>
            {d.count > 1 && <p class="text-xs text-gray-400 mt-0.5">{d.count}x donasi</p>}
          </div>
        ))}
      </div>

      <!-- Latest -->
      <h3 class="text-xl font-bold text-gray-900 mb-5 text-center"><i class="fas fa-clock text-deepin-600 mr-2" /> Donasi Terbaru</h3>
      <div class="max-w-xl mx-auto divide-y divide-gray-100 border rounded-xl overflow-hidden">
        {latest.map((d) => {
          const count = getDonorCount(d);
          return (
            <div class="flex items-center gap-3 px-5 py-3 hover:bg-gray-50 transition-colors">
              <div class="w-9 h-9 rounded-full bg-deepin-50 flex items-center justify-center shrink-0">
                {d.name ? <span class="text-xs font-bold text-deepin-600">{d.name.charAt(0)}</span> : <i class="fas fa-user-secret text-xs text-gray-400" />}
              </div>
              <span class="flex-1 text-sm font-medium text-gray-800">{d.name || 'Anonim'}</span>
              <span class="text-sm font-bold text-deepin-600">Rp {formatRupiah(d.amount)}</span>
              <span class="text-xs text-gray-400 min-w-[85px] text-right">{new Date(d.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
              {d.name ? <span class="text-[10px] font-semibold text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">{count}&times;</span> : <span class="text-[10px] font-semibold text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">-</span>}
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
